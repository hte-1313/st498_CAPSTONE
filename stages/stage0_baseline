def ols_alpha_t(y, X):
    Xc = sm.add_constant(X, has_constant="add")
    res = sm.OLS(y, Xc, missing="drop").fit()
    return {
        "alpha":   float(res.params["const"]),
        "t_alpha": float(res.tvalues["const"]),
        "n":       int(res.nobs),
        "r2":      float(res.rsquared),
    }


def ols_robust(y, X, maxlags, annualization_factor):
    Xc  = sm.add_constant(X, has_constant="add")
    res = sm.OLS(y, Xc, missing="drop").fit(cov_type="HAC", cov_kwds={"maxlags": maxlags})
    alpha = float(res.params["const"])
    return {
        "alpha":            alpha,
        "t_alpha_HAC":      float(res.tvalues["const"]),
        "n":                int(res.nobs),
        "r2":               float(res.rsquared),
        "resid_vol_ann":    float(res.resid.std() * np.sqrt(annualization_factor)),
        "alpha_ann_pct":    alpha * annualization_factor * 100,
    }


def run_baseline_regressions(panel_monthly, panel_weekly, panel_daily):
    REGRESSION_PANELS = {
        "monthly": {"df": panel_monthly, "annualization": 12},
        "weekly":  {"df": panel_weekly,  "annualization": 52},
        "daily":   {"df": panel_daily,   "annualization": 252},
    }

    results_by_freq = {}
    tables_by_freq  = {}

    for freq, cfg in REGRESSION_PANELS.items():
        p   = cfg["df"]
        ann = cfg["annualization"]
        rows = []
        for model_name, facs in MODELS.items():
            for tkr, g in p.groupby("ticker"):
                out = ols_alpha_t(g["excess_ret"], g[facs])
                rows.append({"frequency": freq, "model": model_name, "ticker": tkr, **out})
        alphas = pd.DataFrame(rows).sort_values(["frequency","model","ticker"]).reset_index(drop=True)
        alphas["alpha_ann_pct"] = alphas["alpha"] * ann * 100
        tab = alphas.pivot(index="ticker", columns="model", values=["alpha_ann_pct","t_alpha","r2"])
        tab.columns = [f"{stat}_{model}" for stat, model in tab.columns]
        tab = tab.reset_index().sort_values("ticker").round(3)
        results_by_freq[freq] = alphas
        tables_by_freq[freq]  = tab

    return results_by_freq, tables_by_freq


def run_robust_regressions(panel_monthly, panel_weekly, panel_daily):
    ROBUST_PANELS = {
        "monthly": {"df": panel_monthly, "maxlags": 3,  "annualization": 12},
        "weekly":  {"df": panel_weekly,  "maxlags": 8,  "annualization": 52},
        "daily":   {"df": panel_daily,   "maxlags": 21, "annualization": 252},
    }

    robust_results = {}
    robust_tables  = {}

    for freq, cfg in ROBUST_PANELS.items():
        p       = cfg["df"]
        maxlags = cfg["maxlags"]
        ann     = cfg["annualization"]
        rows = []
        for model_name, facs in MODELS.items():
            for tkr, g in p.groupby("ticker"):
                out = ols_robust(g["excess_ret"], g[facs], maxlags, ann)
                rows.append({"frequency": freq, "model": model_name, "ticker": tkr, **out})
        alphas = pd.DataFrame(rows).sort_values(["frequency","model","ticker"]).reset_index(drop=True)
        tab = alphas.pivot(index="ticker", columns="model",
                           values=["alpha_ann_pct","t_alpha_HAC","resid_vol_ann","r2"])
        tab.columns = [f"{stat}_{model}" for stat, model in tab.columns]
        tab = tab.reset_index().sort_values("ticker").round(3)
        robust_results[freq] = alphas
        robust_tables[freq]  = tab

    return robust_results, robust_tables


def run_subperiod_robustness(panel_monthly, panel_weekly):
    window_results = {}
    for win_name, (wstart, wend) in TEMPORAL_WINDOWS.items():
        panel_w  = panel_monthly[
            (panel_monthly["month"] >= wstart) &
            (panel_monthly["month"] <= wend)
        ].reset_index(drop=True)
        n_months = panel_w["month"].nunique()
        if n_months < 12:
            continue
        rows = []
        for model_name, facs in {"CAPM": ["mkt_rf"], "FF5": ["mkt_rf","smb","hml","rmw","cma"],
                                  "FF5_MOM": FF5MOM_BASE}.items():
            for tkr, g in panel_w.groupby("ticker"):
                est = g.dropna(subset=["excess_ret"] + facs)
                if len(est) < 12:
                    continue
                Xc  = sm.add_constant(est[facs], has_constant="add")
                res = sm.OLS(est["excess_ret"], Xc, missing="drop").fit(
                    cov_type="HAC", cov_kwds={"maxlags": min(3, len(est)//4)})
                rows.append({
                    "window": win_name, "period": f"{wstart} to {wend}",
                    "model": model_name, "ticker": tkr,
                    "n_months":       int(res.nobs),
                    "alpha_ann_pct":  float(res.params["const"]) * 12 * 100,
                    "t_alpha_HAC":    float(res.tvalues["const"]),
                    "r2":             float(res.rsquared),
                })
        if rows:
            window_results[win_name] = pd.DataFrame(rows)

    all_windows = pd.concat(window_results.values(), ignore_index=True)
    all_windows.to_csv(ART_TAB / "stage0_subperiod_results.csv", index=False)
    print(f"Subperiod results saved: {len(all_windows)} rows")
    return window_results


def run_macro_controls(panel_monthly, macro_monthly):
    panel_macro = panel_monthly.merge(macro_monthly, on="month", how="left")
    rows = []
    for win_name, (wstart, wend) in MACRO_WINDOWS.items():
        panel_w = panel_macro[
            (panel_macro["month"] >= wstart) &
            (panel_macro["month"] <= wend)
        ].copy()
        for model_name, facs in MACRO_MODELS.items():
            available = [f for f in facs if f in panel_w.columns]
            for tkr, g in panel_w.groupby("ticker"):
                est = g.dropna(subset=["excess_ret"] + available)
                if len(est) < 18:
                    continue
                Xc  = sm.add_constant(est[available], has_constant="add")
                res = sm.OLS(est["excess_ret"], Xc, missing="drop").fit(
                    cov_type="HAC", cov_kwds={"maxlags": 3})
                rows.append({
                    "window": win_name, "model": model_name, "ticker": tkr,
                    "n":             int(res.nobs),
                    "alpha_ann_pct": float(res.params["const"]) * 12 * 100,
                    "t_alpha_HAC":   float(res.tvalues["const"]),
                    "r2":            float(res.rsquared),
                    "resid_vol_ann_pct": float(res.resid.std() * np.sqrt(12)) * 100,
                })
    macro_alphas = pd.DataFrame(rows)
    macro_alphas.to_csv(ART_TAB / "stage0_macro_augmented_alphas.csv", index=False)
    print(f"Macro results saved: {len(macro_alphas)} rows")
    return macro_alphas


def save_baseline_tables(results_by_freq, tables_by_freq, robust_results, robust_tables):
    for freq in ["monthly","weekly","daily"]:
        tables_by_freq[freq].to_csv(
            ART_TAB / f"stage0_baseline_table_with_r2_{freq}.csv", index=False)
        results_by_freq[freq].to_csv(
            ART_TAB / f"stage0_baseline_alphas_long_{freq}.csv", index=False)
        robust_tables[freq].to_csv(
            ART_TAB / f"stage0_robust_table_{freq}.csv", index=False)
        robust_results[freq].to_csv(
            ART_TAB / f"stage0_robust_alphas_{freq}.csv", index=False)
    print("All baseline tables saved.")


if __name__ == "__main__":
    panel_monthly, panel_weekly, panel_daily = load_balanced_panels()
    results_by_freq, tables_by_freq = run_baseline_regressions(panel_monthly, panel_weekly, panel_daily)
    robust_results, robust_tables   = run_robust_regressions(panel_monthly, panel_weekly, panel_daily)
    save_baseline_tables(results_by_freq, tables_by_freq, robust_results, robust_tables)
    run_subperiod_robustness(panel_monthly, panel_weekly)
    print("Stage 0 complete.")
