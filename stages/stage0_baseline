_YYYYMM_RE   = re.compile(r"^\s*(\d{6})\s*,")
_YYYYMMDD_RE = re.compile(r"^\s*(\d{8})\s*,")


def _read_zipped_csv_text(url):
    r = requests.get(url, timeout=60)
    r.raise_for_status()
    z = zipfile.ZipFile(io.BytesIO(r.content))
    name = [n for n in z.namelist() if n.lower().endswith(".csv")][0]
    return z.read(name).decode("latin-1")


def _extract_first_date_block(text, n_cols, date_digits):
    pat = _YYYYMM_RE if date_digits == 6 else _YYYYMMDD_RE
    rows = []
    in_block = False
    for line in text.splitlines():
        if pat.match(line):
            parts = [p.strip() for p in line.split(",")]
            if len(parts) >= n_cols:
                rows.append(parts[:n_cols])
                in_block = True
        else:
            if in_block:
                break
    return pd.DataFrame(rows)


def _clean_percent_columns(df, cols, divide_by_100=True):
    d = df.copy()
    for c in cols:
        d[c] = pd.to_numeric(d[c], errors="coerce")
        d.loc[d[c] <= -99, c] = np.nan
        if divide_by_100:
            d[c] = d[c] / 100.0
    return d


def _add_period_columns(df, date_col, freq):
    d = df.copy()
    if freq == "M":
        d["period_obj"] = d[date_col].dt.to_period("M")
    elif freq == "W":
        d["period_obj"] = d[date_col].dt.to_period("W-FRI")
    elif freq == "D":
        d["period_obj"] = d[date_col].dt.to_period("D")
    d["period"] = d["period_obj"].astype(str)
    d["period_end_date"] = d[date_col]
    return d


def _compound_simple_returns(x):
    x = pd.to_numeric(x, errors="coerce").dropna()
    if len(x) == 0:
        return np.nan
    return (1.0 + x).prod() - 1.0


def _aggregate_daily_to_weekly(df_daily, value_cols, date_col="date"):
    d = df_daily.copy().sort_values(date_col).reset_index(drop=True)
    d["period_obj"] = d[date_col].dt.to_period("W-FRI")
    d["period"] = d["period_obj"].astype(str)
    agg_dict = {c: (c, _compound_simple_returns) for c in value_cols}
    agg_dict["period_end_date"] = (date_col, "max")
    return (
        d.groupby(["period_obj","period"], as_index=False)
        .agg(**agg_dict)
        .sort_values("period")
        .reset_index(drop=True)
    )


