def build_ff_factors():
    print("Downloading FF factors...")
    ff3_monthly         = download_ff3_monthly()
    ff3_weekly_official = download_ff3_weekly()
    ff3_daily           = download_ff3_daily()
    ff5_monthly         = download_ff5_monthly()
    ff5_daily           = download_ff5_daily()
    mom_monthly         = download_mom_monthly()
    mom_daily           = download_mom_daily()

    ff_monthly = (
        ff5_monthly
        .merge(mom_monthly[["period","mom"]], on="period", how="left")
        .dropna().sort_values("period").reset_index(drop=True)
    )

    ff_daily = (
        ff5_daily
        .merge(mom_daily[["date","mom"]], on="date", how="left")
        .dropna().sort_values("date").reset_index(drop=True)
    )

    ff5_weekly_derived = _aggregate_daily_to_weekly(ff5_daily, ["mkt_rf","smb","hml","rmw","cma","rf"], date_col="date")
    mom_weekly_derived = _aggregate_daily_to_weekly(mom_daily, ["mom"], date_col="date")
    ff5_mom_weekly_derived = (
        ff5_weekly_derived
        .merge(mom_weekly_derived[["period","mom"]], on="period", how="left")
        .dropna().sort_values("period").reset_index(drop=True)
    )

    ff_weekly_hybrid = (
        ff3_weekly_official[["period","period_end_date","rf","mkt_rf","smb","hml"]]
        .merge(ff5_weekly_derived[["period","rmw","cma"]], on="period", how="left")
        .merge(mom_weekly_derived[["period","mom"]], on="period", how="left")
        .sort_values("period").reset_index(drop=True)
    )

    for p, name in [
        (DATA_RAW / "ff3_monthly.parquet",         ff3_monthly),
        (DATA_RAW / "ff5_monthly.parquet",         ff5_monthly),
        (DATA_RAW / "ff5_mom_monthly.parquet",     ff_monthly),
        (DATA_RAW / "ff3_daily.parquet",           ff3_daily),
        (DATA_RAW / "ff5_daily.parquet",           ff5_daily),
        (DATA_RAW / "ff5_mom_daily.parquet",       ff_daily),
        (DATA_RAW / "ff5_mom_weekly_derived.parquet", ff5_mom_weekly_derived),
    ]:
        name.to_parquet(p, index=False)

    print("FF factors saved.")
    return ff_monthly, ff_weekly_hybrid, ff_daily


